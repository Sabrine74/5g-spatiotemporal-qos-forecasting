          "query": "from(bucket: \"qos\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"forecast_interval\" and r._field == \"lower\") |> keep(columns: [\"_time\",\"_value\"]) |> set(key: \"_field\", value: \"Lower bound\")"
